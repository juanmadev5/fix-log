# Copy to .env and adjust if you need non-default values.
# docker-compose.yml already ships safe local-dev defaults, so this file
# is optional for a quick start — only needed to override something.

POSTGRES_USER=fixlog
POSTGRES_PASSWORD=fixlog
POSTGRES_PORT=5433
API_PORT=5167

# Must be at least 32 characters. Only matters if you're issuing tokens
# you want to keep valid across container restarts/rebuilds.
JWT_SECRET=local_dev_secret_key_at_least_32_characters_long
